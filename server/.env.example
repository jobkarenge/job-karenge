# Server Configuration
PORT=3000
NODE_ENV=production
CLIENT_URL=https://job-karenge.netlify.app
SERVER_URL=https://your-backend-domain.com

# MongoDB Atlas
MONGODB_URI=

# JWT Secrets
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
EMAIL_VERIFICATION_SECRET=
PASSWORD_RESET_SECRET=

# Optional Super Admin Bootstrap Passcode
ADMIN_SETUP_PASSCODE=

# Cloudinary Credentials (set individual keys or CLOUDINARY_URL)
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gmail SMTP Credentials via Nodemailer (for transactional & promotional emails)
EMAIL_PROVIDER=gmail
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=Job Karenge
EMAIL_FROM_EMAIL=
