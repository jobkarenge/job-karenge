# Server Configuration
PORT=3000
NODE_ENV=development
CLIENT_URL=
SERVER_URL=

# MongoDB Atlas (leave empty in preview to use server-side persistent JSON store)
MONGODB_URI=

# JWT Secrets (optional in dev; generated in-memory if omitted)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
EMAIL_VERIFICATION_SECRET=
PASSWORD_RESET_SECRET=

# Optional Super Admin Bootstrap Passcode (if empty, first-run setup UI in /admin/setup claims admin)
ADMIN_SETUP_PASSCODE=

# Cloudinary Credentials (either set individual keys or CLOUDINARY_URL)
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gmail SMTP Credentials via Nodemailer (for transactional & promotional emails)
EMAIL_PROVIDER=gmail
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=Job Karenge
EMAIL_FROM_EMAIL=

# Frontend API URL (leave empty for same-origin /api)
VITE_API_URL=
