# Server Configuration
PORT=3000
NODE_ENV=development
CLIENT_URL=
SERVER_URL=

# MongoDB Atlas (leave empty in preview to use server-side persistent JSON store)
MONGODB_URI=

# JWT Secrets (optional in dev; generated in-memory if omitted)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
EMAIL_VERIFICATION_SECRET=
PASSWORD_RESET_SECRET=

# Optional Super Admin Bootstrap Passcode (if empty, first-run setup UI in /admin/setup claims admin)
ADMIN_SETUP_PASSCODE=

# Cloudinary Credentials (for image optimization & compressed <1MB PDF resumes)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Brevo API Credentials (for transactional & promotional emails)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Job Karenge
BREVO_BASE_URL=https://api.brevo.com/v3
BREVO_WEBHOOK_SECRET=

# Frontend API URL (leave empty for same-origin /api)
VITE_API_URL=
